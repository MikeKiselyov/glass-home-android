<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Home's screensaver: photos crossfading, the clock and date in the corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/dream_photo_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/dream_photo_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="bottom"
        android:background="@drawable/dream_scrim" />

    <LinearLayout
        android:id="@+id/dream_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dream_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowRadius="16"
            android:textColor="#F2FFFFFF"
            android:textSize="96dp" />

        <TextView
            android:id="@+id/dream_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="#66000000"
            android:shadowRadius="10"
            android:textColor="#CCFFFFFF"
            android:textSize="22dp" />
    </LinearLayout>
</FrameLayout>
