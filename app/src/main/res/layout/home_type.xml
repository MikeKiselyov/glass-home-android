<?xml version="1.0" encoding="utf-8"?>
<!-- Theme "Type": no icons; the apps are large words over the photo. The lightest theme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <include
        layout="@layout/part_photos"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#610A0E14" />

    <View
        android:id="@+id/music_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black" />

    <View
        android:id="@+id/night_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FF1F0E00" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="48dp"
        android:layout_marginTop="36dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#E6FFFFFF"
            android:textSize="17dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="48dp"
        android:textColor="#E6FFFFFF"
        android:textSize="17dp"
        android:visibility="gone" />

    <!-- Weather style "week": seven days on a frosted panel. -->
    <include
        layout="@layout/part_weather_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="48dp" />

    <!-- Corner and forecast weather styles. -->
    <include
        layout="@layout/part_weather_corner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="48dp" />

    <include
        layout="@layout/part_now_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="48dp"
        android:layout_marginTop="80dp" />

    <HorizontalScrollView
        android:id="@+id/dock_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="58dp"
        android:clipToPadding="false"
        android:fadingEdgeLength="40dp"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="20dp"
        android:gravity="end"
        android:textColor="#99FFFFFF"
        android:textSize="10dp" />

    <TextView
        android:id="@+id/type_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="20dp"
        android:textColor="#99FFFFFF"
        android:textSize="10dp" />

    <include layout="@layout/part_vpn" />


    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
